{
  "name": "maincraft-app",
  "productName": "Maincraft",
  "version": "0.1.0",
  "description": "Maincraft — ИИ-персонажи для Minecraft: сервер, боты и NPC в одном приложении",
  "main": "./out/main/index.js",
  "author": "Maincraft",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "npm run build && npm run agent:bundle && electron-builder",
    "dist:win": "npm run build && npm run agent:bundle && electron-builder --win --x64",
    "dist:linux": "npm run build && npm run agent:bundle && electron-builder --linux AppImage",
    "agent:bundle": "node scripts/bundle-agent.mjs",
    "icons": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "https-proxy-agent": "^9.1.0",
    "msedge-tts": "^2.0.7",
    "tar": "^7.5.22",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "zustand": "^5.0.15"
  }
}
