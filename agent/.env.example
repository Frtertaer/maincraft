# Copy to agent/.env (already gitignored) or export these vars before launch.
# Never commit real keys.

# Opus 5 planner (required for every mode — drives goal/plan + player commands)
OPUS_API_KEY=sk-ant-your-key-here

# Jev fast controller (controller.type=jev). TypeSafe System One API.
TYPESAFE_API_KEY=apikey_your-key-here

# Laya fast controller (controller.type=laya): no key needed, it talks to a
# local sidecar. Start it first:
#   pip install laya
#   python agent/tools/laya_server.py        # LAYA_PORT=8091 LAYA_DEVICE=cpu
